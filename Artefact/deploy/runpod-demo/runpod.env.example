PORT=8000
PORT_HEALTH=8081
HEALTH_CHECK_PATH=/ping
QA_DATA_DIR=/runpod-volume
DEFAULT_MODEL_KEY=llama3.2-finetuned
DEMO_MODELS=llama3.2-base,llama3.2-finetuned,gemma2-base,gemma2-finetuned
EMBEDDING_DEVICE=cpu
RERANKER_DEVICE=cpu
QUEUE_CONCURRENCY=3
OLLAMA_NUM_PARALLEL=1
MAX_QUEUE=4
QUEUE_WAIT_TIMEOUT=120
OLLAMA_TIMEOUT=180
QA_STARTUP_TIMEOUT=1200
# HF_TOKEN: gunakan Runpod Secret bila sumber Hugging Face memerlukan akses.
